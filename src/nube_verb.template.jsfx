  sprintf(#s, "%.1f dB", slider18); knob(16, _kx, _ky, _kr, "Anti-eses", slider18 >= 0.05 ? #s : "Apagado", ctl_get(16), 0, 1); _kx += _ks;
) : tab == 1 ? (
