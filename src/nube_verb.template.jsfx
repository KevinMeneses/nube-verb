_c = 0; _px = -1;
loop(_n + 1,
  _xx = dx + _c * SC; _r = slider27 ? 300 : rt_at(x2f(_xx)); _yy = r2y(_r);
  acc(0.10); gfx_line(_xx, _yy, _xx, dy + dh - 1);
  _px >= 0 ? ( acc(1); gfx_line(_px, _py, _xx, _yy, 1); gfx_line(_px, _py - 1, _xx, _yy - 1, 1); );
  _px = _xx; _py = _yy; _c += 1;
);
// puntos
function handle(id, x, y, lbl) (
