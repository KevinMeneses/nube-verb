  gfx_set(0.62, 0.65, 0.72, 1); gfx_measurestr("ENTRADA", _tw, _th); _xx -= _tw + 14 * SC; text_l("ENTRADA", _xx, hy + 22 * SC, 14 * SC);
  hit_add(hx, hy, hgw, hh, 100);
);
// pestanas de la vista
