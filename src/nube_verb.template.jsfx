);

// ---- decay por frecuencia
gfx_set(0.095, 0.105, 0.135, 1); gfx_rect(dx, dy, dw, dh, 1);
// zonas cortadas por los filtros
slider16 > 20.5 ? ( gfx_set(0, 0, 0, 0.28); gfx_rect(dx, dy, f2x(slider16) - dx, dh, 1); );
_hc = min(slider17 < 19990 ? slider17 : 100000, slider26 == 2 ? 6500 : slider26 == 1 ? 11000 : 100000);
_hc < 20000 ? ( gfx_set(0, 0, 0, 0.28); gfx_rect(f2x(_hc), dy, dx + dw - f2x(_hc), dh, 1); );
fnt(4);
_f = 100; loop(3, _xx = f2x(_f); gfx_set(1, 1, 1, 0.05); gfx_line(_xx, dy + 18 * SC, _xx, dy + dh - 16 * SC);
  gfx_set(0.50, 0.53, 0.60, 1); text_c(_f < 1000 ? "100 Hz" : _f < 10000 ? "1 kHz" : "10 kHz", _xx - 30 * SC, dy + dh - 16 * SC, 60 * SC, 14 * SC); _f *= 10; );
_k = 0;
loop(7,
  _r = _k == 0 ? 0.2 : _k == 1 ? 0.5 : _k == 2 ? 1 : _k == 3 ? 2 : _k == 4 ? 5 : _k == 5 ? 10 : 20;
  _yy = r2y(_r); gfx_set(1, 1, 1, 0.04); gfx_line(dx, _yy, dx + dw - 1, _yy);
  gfx_set(0.50, 0.53, 0.60, 1); sprintf(#s, _r < 1 ? "%.1f s" : "%d s", _r); text_l(#s, dx + 4 * SC, _yy - 13 * SC, 12 * SC);
  _k += 1;
);
// espectro de la reverb
_p = anawp - FFTN; _p < 0 ? _p += ANAN;
_i = 0; _q = _p;
loop(FFTN, fftbuf[_i] = anaBuf[_q] * (0.5 - 0.5 * cos(2 * $pi * _i / FFTN)); (_q += 1) >= ANAN ? _q = 0; _i += 1; );
fft_real(fftbuf, FFTN); fft_permute(fftbuf, FFTN / 2);
_i = 1;
loop(FFTN / 2 - 1,
  _re = fftbuf[2 * _i]; _im = fftbuf[2 * _i + 1];
  _db = 10 * log10(_re * _re + _im * _im + 0.00000000000000000001) - 20 * log10(FFTN / 4) + 4.5 * log(max(_i * srate / FFTN, 10) / 1000) / log(2);
  spec[_i] = _db > spec[_i] ? _db : max(_db, spec[_i] - 0.8);
  _i += 1;
);
_c = 0; _n = floor(dw / SC); _px = -1;
loop(_n,
  _f = x2f(dx + _c * SC); _b = _f * FFTN / srate;
  _b >= 1 && _b < FFTN / 2 - 2 ? (
    _k = floor(_b); _v = spec[_k] + (spec[_k + 1] - spec[_k]) * (_b - _k);
    _xx = dx + _c * SC; _yy = dy + dh * (1 - clamp((_v + 90) / 96, 0, 1));
